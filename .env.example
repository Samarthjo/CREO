# Where founding-cohort applications are stored. Server-only: never prefix these with NEXT_PUBLIC_.
# Supabase project URL and publishable key (Project Settings > API Keys). The table and its
# insert-only policy are in supabase/migrations.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Lets the daily Vercel cron call /api/keepalive so a free Supabase project is not paused. Any long random string.
CRON_SECRET=

# Optional alternative to Supabase: any HTTPS endpoint that accepts a JSON POST (Make, Zapier, Google Apps Script).
# With neither set, applications are appended to .data/applications.jsonl in development and refused in production.
CREO_APPLICATIONS_WEBHOOK=

# The access code for the workspace (/app). While it is empty nobody can open the workspace. Choose anything hard to guess;
# changing it signs everyone out. Server-only.
WORKSPACE_ACCESS_CODE=

# Analytics (PostHog, US cloud). The public project key from PostHog: Project settings, Project token (starts with phc_). It is safe in the
# browser, and it is inlined at build time, so set it in Vercel for the Production environment only: previews and local runs then send nothing.
NEXT_PUBLIC_POSTHOG_KEY=
